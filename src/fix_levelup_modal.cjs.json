const fs = require('fs');
let content = fs.readFileSync('hooks/useGame.ts', 'utf-8');

content = content.replace(/nextCharState\.money \+= gold;/g, "nextCharState.money += gold; accumulatedExp += exp; accumulatedGold += gold; if (typeof loot !== 'undefined') accumulatedLoot.push(...loot);");

fs.writeFileSync('hooks/useGame.ts', content);
